# ========================================================
# Veridex One Finance SaaS — Environment Variables Template
# ========================================================
# Copy this file to .env and configure your values.
# NEVER commit sensitive passwords, keys, or credentials to Git.

PORT=5000
NODE_ENV=development

# Primary Application Database (Used in development & production)
MONGODB_URI=mongodb://localhost:27017/veridex_finance
# For MongoDB Atlas (production/staging):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/veridex_finance?retryWrites=true&w=majority

# ========================================================
# TEST DATABASE ISOLATION (MANDATORY WHEN NODE_ENV=test)
# ========================================================
# When running automated test suites (NODE_ENV=test), the system
# strictly requires TEST_MONGODB_URI and refuses to run against or
# fall back to MONGODB_URI. The test database name MUST be distinct
# from the primary application database name to prevent data pollution.
TEST_MONGODB_URI=mongodb://localhost:27017/veridex_finance_test
# For MongoDB Atlas isolated test database:
# TEST_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/veridex_finance_test?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_production
DEFAULT_TENANT_ID=
BASE_CURRENCY=INR

# Feature Toggles
ENABLE_LEGACY_POSTING_ADAPTER=false
ENABLE_DEV_RESET=false
FORCE_PUBLIC_DNS=false

# Optional External Integrations (Leave blank for Sandbox simulation mode)
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_ID=
# GSTN_API_KEY=
# NIC_PORTAL_CLIENT_ID=
